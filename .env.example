# =============================================================================
# VEIL AI — environment configuration
# Copy to .env.local for development. NEVER commit real values.
# Every integration is optional: anything missing puts that feature into a
# clearly-labelled DEMO / NOT CONNECTED state. The server prints what is
# missing at startup.
# =============================================================================

# --- Application -------------------------------------------------------------
# Public URL of this deployment (used for CSRF origin checks and metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret for signing NEP-413 challenge cookies. Generate: openssl rand -hex 32
APP_SECRET=
# 32-byte key for application-level AES-256-GCM encryption of stored chat
# messages, goals and saved reports. 64 hex chars or base64.
# Generate: openssl rand -hex 32   (Losing this key makes stored text unreadable.)
DATA_ENCRYPTION_KEY=

# --- NEAR AI Cloud (confidential inference + TEE attestation) ---------------
# Create a key at https://cloud.near.ai — server-side only, never exposed.
NEAR_AI_API_KEY=
# Optional overrides
NEAR_AI_BASE_URL=https://cloud-api.near.ai
# Any TEE model from GET /v1/models. Default comes from NEAR's official verifier.
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1
# End-to-end encryption to the attested enclave key: preferred | required | off
NEAR_AI_E2EE=preferred
NEAR_AI_MAX_TOKENS=1200
# Allow no-account demo visitors to use live NEAR AI inference on SAMPLE data
# (rate-limited). Set to "false" to give demo visitors template answers only.
DEMO_ALLOW_LIVE_AI=true

# --- Supabase (auth + persistence, protected by Row Level Security) ---------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not used by the running app (all user queries run as the user under RLS).
# Only needed for admin tooling / migrations. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Set to "true" after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- NEAR network & blockchain data providers --------------------------------
NEXT_PUBLIC_NEAR_NETWORK=mainnet
# Comma-separated JSON-RPC endpoints (first = primary). Defaults: FastNEAR free RPC, then rpc.mainnet.near.org
NEAR_RPC_URLS=
# Optional — raises NearBlocks rate limits (anonymous access works with low limits).
NEARBLOCKS_API_KEY=
# Optional — FastNEAR API key.
FASTNEAR_API_KEY=

# --- Market data --------------------------------------------------------------
# NEAR Intents 1Click token list (public, no key) is the primary price source.
ONECLICK_API_BASE=https://1click.chaindefuser.com
# Optional CoinGecko key for 24h change and price history (free "demo" plan works).
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo

# --- Wallet risk lists (optional) ---------------------------------------------
# JSON array of sourced entries. Entries without an http(s) source are ignored.
# RISK_LIST_JSON=[{"account":"example.near","reason":"reported exploit","source":"https://..."}]
RISK_LIST_JSON=
